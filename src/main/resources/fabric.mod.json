  "authors": ["Codex"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ethicalautototem.AutoTotemClient"
    ]
  },
  "mixins": [
    "ethicalautototem.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}
